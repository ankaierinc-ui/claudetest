{
  "mcpServers": {
    "n8n": {
      "command": "npx",
      "args": ["n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "N8N_API_URL": "https://n8n.ankaiers.com",
        "N8N_API_KEY": "YOUR_API_KEY_HERE",
        "N8N_MCP_TELEMETRY_DISABLED": "true"
      }
    }
  }
}

# Shopify Contact Scraper - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================

# Google Sheets Document ID
# Get from: https://docs.google.com/spreadsheets/d/{GOOGLE_SHEETS_ID}/edit
GOOGLE_SHEETS_ID=your-google-sheets-id-here

# Google Sheets Sheet ID (numeric ID of the specific sheet)
# Find in URL or sheet properties
GOOGLE_SHEETS_SHEET_ID=1489016821

# ============================================================
# SECURITY & ENCRYPTION (PII Protection)
# ============================================================

# PII Encryption Master Key (32+ characters, hex or base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used with PBKDF2 to derive the actual AES-256 encryption key
PII_ENCRYPTION_KEY=your-master-key-32-chars-minimum-here

# PII Encryption Salt (16+ characters, hex or base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Used with PBKDF2 for key derivation with 100,000 iterations
PII_ENCRYPTION_SALT=your-salt-16-chars-minimum-here

# Enable/disable PII encryption for email and phone
PII_ENCRYPTION_ENABLED=true

# Optional: Google OAuth2 credentials (if not using n8n's credential manager)
# These are typically managed in n8n UI, but can be env vars if needed
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ============================================================
# API CONFIGURATION (Optional)
# ============================================================

# Shopify API credentials (if needed in future)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_SCOPES=read_products

# ============================================================
# RATE LIMITING & PERFORMANCE
# ============================================================

# Max HTTP requests per minute to Shopify stores
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Max content length for processing (bytes)
MAX_CONTENT_LENGTH=5000000

# Max email and phone numbers to extract per store
MAX_EMAILS_PER_STORE=1000
MAX_PHONES_PER_STORE=1000

# ============================================================
# RETRY & TIMEOUT CONFIGURATION
# ============================================================

# Maximum retry attempts for failed requests
MAX_RETRIES=3

# Initial retry delay in milliseconds (exponential backoff)
RETRY_INITIAL_DELAY_MS=1000

# Maximum retry delay in milliseconds (cap)
RETRY_MAX_DELAY_MS=30000

# HTTP request timeouts (milliseconds)
HTTP_TIMEOUT_HOMEPAGE_MS=30000
HTTP_TIMEOUT_CONTACT_PAGE_MS=20000

# ============================================================
# LOGGING & MONITORING
# ============================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed operation logs
DEBUG_MODE=false

# ============================================================
# SECURITY SETTINGS
# ============================================================

# Enforce HTTPS only (no HTTP)
ENFORCE_HTTPS_ONLY=true

# Enable SSL certificate verification
VERIFY_SSL_CERTIFICATES=true

# ============================================================
# NOTES FOR SETUP
# ============================================================

# 1. PII Encryption Setup:
#    A. Generate encryption key (32+ characters):
#       $ node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#       Output: a1b2c3d4e5f6...
#       Set PII_ENCRYPTION_KEY=a1b2c3d4e5f6...
#
#    B. Generate encryption salt (16+ characters):
#       $ node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#       Output: x9y8z7w6...
#       Set PII_ENCRYPTION_SALT=x9y8z7w6...
#
#    C. Or use the Node.js utility:
#       $ node -e "const PE = require('./utils/encryption'); console.log(JSON.stringify(PE.generateKeyAndSalt(), null, 2))"

# 2. Google Sheets ID:
#    - Open your Google Sheet
#    - URL: https://docs.google.com/spreadsheets/d/1hbMFXnaSzzTFkRDhhqdWVshu7xmuDIDtVspPHJyXLqw/edit
#    - ID: 1hbMFXnaSzzTFkRDhhqdWVshu7xmuDIDtVspPHJyXLqw

# 3. Google Sheets Schema (with encryption):
#    Columns:
#    - A: Store URL
#    - B: Contact URL
#    - C: Name
#    - D: Email (Masked) - for display
#    - E: Email (Encrypted) - for storage
#    - F: Email (Hash) - for deduplication
#    - G: Phone (Masked) - for display
#    - H: Phone (Encrypted) - for storage
#    - I: Phone (Hash) - for deduplication
#    - J: Form Fields
#    - K: Confidence Score
#    - L: Extracted At

# 4. Google OAuth2:
#    - Configure in n8n UI under Credentials
#    - Scopes: https://www.googleapis.com/auth/spreadsheets, https://www.googleapis.com/auth/drive
#    - Enable "offline access" for refresh tokens

# 5. Security Best Practices:
#    - Keep .env file private (in .gitignore)
#    - Rotate PII_ENCRYPTION_KEY periodically (see docs/ENCRYPTION.md)
#    - Use masked versions in logs, never log encrypted or plaintext PII
#    - Audit Google Sheets access logs regularly
#    - Backup encryption keys securely (separate from application)
#    - Test decryption process regularly
